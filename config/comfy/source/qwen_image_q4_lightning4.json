ame":"采样器名称","name":"sampler_name","type":"COMBO","widget":{"name":"sampler_name"},"link":null},{"localized_name":"调度器","name":"scheduler","type":"COMBO","widget":{"name":"scheduler"},"link":null},{"localized_name":"降噪","name":"denoise","type":"FLOAT","widget":{"name":"denoise"},"link":null}],"outputs":[{"localized_name":"Latent","name":"LATENT","type":"LATENT","links":[9]}],"properties":{"Node name for S&R":"KSampler"},"widgets_values":[156680208700286,"randomize",4,1,"euler","simple",1],"widgets_values_named":{"seed":156680208700286,"control_after_generate":"randomize","steps":4,"cfg":1,"sampler_name":"euler","scheduler":"simple","denoise":1}},{"id":10,"type":"VAEDecode","pos":[1265,220],"size":[210,46],"flags":{},"order":10,"mode":0,"inputs":[{"localized_name":"Latent","name":"samples","type":"LATENT","link":9},{"localized_name":"vae","name":"vae","type":"VAE","link":10}],"outputs":[{"localized_name":"图像","name":"IMAGE","type":"IMAGE","links":[11]}],"properties":{"Node name for S&R":"VAEDecode"}},{"id":11,"type":"SaveImage","pos":[1265,300],"size":[480,460],"flags":{},"order":11,"mode":0,"inputs":[{"localized_name":"图片","name":"images","type":"IMAGE","link":11},{"localized_name":"文件名前缀","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"properties":{"Node name for S&R":"SaveImage"},"widgets_values":["qwen_image/qwen_q4_lightning4"],"widgets_values_named":{"filename_prefix":"qwen_image/qwen_q4_lightning4"}},{"id":12,"type":"MarkdownNote","pos":[60,600],"size":[340,520],"flags":{},"order":4,"mode":0,"inputs":[],"outputs":[],"properties":{"Node name for S&R":"MarkdownNote"},"widgets_values":["## Qwen-Image（GGUF Q4_K_S）文生图\n\n**本文件由 ComfyUI 官方模板 `image_qwen_image` 改造：`UNETLoader` → `UnetLoaderGGUF`，模型换成下面这些本地文件。**\n\n### 必需模型（全部在本机 `~/ComfyUI-Shared/models`）\n\n| 目录 | 文件 | 体积 | 说明 |\n| --- | --- | --- | --- |\n| `diffusion_models/` | `qwen-image-Q4_K_S.gguf` | 11.3 GB | 主模型（GGUF 量化） |\n| `text_encoders/` | `qwen_2.5_vl_7b_fp8_scaled.safetensors` | 8.7 GB | 文本编码器，`CLIPLoader` 类型必须选 `qwen_image` |\n| `vae/` | `qwen_image_vae.safetensors` | 242 MB | VAE |\n\n- LoRA：`loras/Qwen-Image-Lightning-4steps-V2.0-bf16.safetensors`（810 MB）\n\n### 采样参数（当前写入值）\n\n- steps = **4**\n- cfg = **1.0**\n- sampler = `euler`，scheduler = `simple`，denoise = 1.0\n- `ModelSamplingAuraFlow.shift` = **3.1**\n- 分辨率 1328×1328（官方模板推荐 1:1 尺寸）\n\n### 推荐值说明\n\n- 基础模型（不用 Lightning LoRA）：官方模板默认 20 步 / cfg 4.0，原版 Qwen-Image 官方给的是 50 步。\n- Lightning 8 步 LoRA（V2.0）：**8 步 / cfg 1.0**，官方蒸馏使用 shift=3.0。\n- Lightning 4 步 LoRA（V2.0）：**4 步 / cfg 1.0**，shift 同 8 步。\n- cfg=1.0 时负向提示词不参与计算，负向框留空即可。\n\n### 常见问题\n\n- `UnetLoaderGGUF` 不存在：说明 `ComfyUI-GGUF` 自定义节点没加载，重启 ComfyUI 后再试。\n- 下拉里看不到模型：确认文件放在 `~/ComfyUI-Shared/models/<对应目录>/`，刷新浏览器即可，无需重启。\n- GGUF 主模型速度慢属正常现象，Q4_K_S 在 Apple Silicon / MPS 上单图耗时明显高于 CUDA。\n"],"widgets_values_named":{"text":"## Qwen-Image（GGUF Q4_K_S）文生图\n\n**本文件由 ComfyUI 官方模板 `image_qwen_image` 改造：`UNETLoader` → `UnetLoaderGGUF`，模型换成下面这些本地文件。**\n\n### 必需模型（全部在本机 `~/ComfyUI-Shared/models`）\n\n| 目录 | 文件 | 体积 | 说明 |\n| --- | --- | --- | --- |\n| `diffusion_models/` | `qwen-image-Q4_K_S.gguf` | 11.3 GB | 主模型（GGUF 量化） |\n| `text_encoders/` | `qwen_2.5_vl_7b_fp8_scaled.safetensors` | 8.7 GB | 文本编码器，`CLIPLoader` 类型必须选 `qwen_image` |\n| `vae/` | `qwen_image_vae.safetensors` | 242 MB | VAE |\n\n- LoRA：`loras/Qwen-Image-Lightning-4steps-V2.0-bf16.safetensors`（810 MB）\n\n### 采样参数（当前写入值）\n\n- steps = **4**\n- cfg = **1.0**\n- sampler = `euler`，scheduler = `simple`，denoise = 1.0\n- `ModelSamplingAuraFlow.shift` = **3.1**\n- 分辨率 1328×1328（官方模板推荐 1:1 尺寸）\n\n### 推荐值说明\n\n- 基础模型（不用 Lightning LoRA）：官方模板默认 20 步 / cfg 4.0，原版 Qwen-Image 官方给的是 50 步。\n- Lightning 8 步 LoRA（V2.0）：**8 步 / cfg 1.0**，官方蒸馏使用 shift=3.0。\n- Lightning 4 步 LoRA（V2.0）：**4 步 / cfg 1.0**，shift 同 8 步。\n- cfg=1.0 时负向提示词不参与计算，负向框留空即可。\n\n### 常见问题\n\n- `UnetLoaderGGUF` 不存在：说明 `ComfyUI-GGUF` 自定义节点没加载，重启 ComfyUI 后再试。\n- 下拉里看不到模型：确认文件放在 `~/ComfyUI-Shared/models/<对应目录>/`，刷新浏览器即可，无需重启。\n- GGUF 主模型速度慢属正常现象，Q4_K_S 在 Apple Silicon / MPS 上单图耗时明显高于 CUDA。\n"},"color":"#432","bgcolor":"#653"}],"links":[[1,1,0,4,0,"MODEL"],[2,4,0,5,0,"MODEL"],[3,2,0,6,0,"CLIP"],[4,2,0,7,0,"CLIP"],[5,5,0,9,0,"MODEL"],[6,6,0,9,1,"CONDITIONING"],[7,7,0,9,2,"CONDITIONING"],[8,8,0,9,3,"LATENT"],[9,9,0,10,0,"LATENT"],[10,3,0,10,1,"VAE"],[11,10,0,11,0,"IMAGE"]],"groups":[],"config":{},"extra":{"title":"Qwen-Image GGUF + Lightning 4 步","ds":{"scale":0.5630498533724341,"offset":[234.16666666666652,161.36197916666663]}},"version":0.4}