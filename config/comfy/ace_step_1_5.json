{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "ace_step_1.5_turbo_aio.safetensors"
    }
  },
  "2": {
    "class_type": "TextEncodeAceStepAudio1.5",
    "inputs": {
      "clip": [
        "1",
        1
      ],
      "tags": "{{prompt}}",
      "lyrics": "{{lyrics}}",
      "seed": "{{seed}}",
      "bpm": "{{bpm}}",
      "duration": "{{duration}}",
      "timesignature": "{{timesignature}}",
      "language": "{{language}}",
      "keyscale": "{{keyscale}}",
      "generate_audio_codes": true,
      "cfg_scale": 2,
      "temperature": 0.85,
      "top_p": 0.9,
      "top_k": 0,
      "min_p": 0
    }
  },
  "3": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "shift": 3,
      "model": [
        "1",
        0
      ]
    }
  },
  "4": {
    "class_type": "EmptyAceStep1.5LatentAudio",
    "inputs": {
      "seconds": "{{duration}}",
      "batch_size": 1
    }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed}}",
      "steps": 8,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": [
        "3",
        0
      ],
      "positive": [
        "2",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "latent_image": [
        "4",
        0
      ]
    }
  },
  "6": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "2",
        0
      ]
    }
  },
  "7": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "5",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "8": {
    "class_type": "SaveAudioAdvanced",
    "inputs": {
      "audio": [
        "7",
        0
      ],
      "filename_prefix": "{{filename_prefix}}",
      "format": "flac"
    }
  }
}
