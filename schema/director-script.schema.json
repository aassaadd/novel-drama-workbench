{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-drama.local/schema/director-script.schema.json",
  "title": "导演脚本（scripts/<chapterId>.json）",
  "description": "由章节正文与设定库生成的生产中间层：镜头 → 台词 / 音效 / 画面 / 动画 / 转场。每个元素必须带 anchor 回指正文。",
  "type": "object",
  "required": ["schema_version", "id", "chapter_id", "work_id", "source", "status", "shots", "created_at", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^scr_[0-9A-Za-z]{6,32}$" },
    "chapter_id": { "type": "string", "pattern": "^chp_[0-9A-Za-z]{6,32}$" },
    "work_id": { "type": "string", "pattern": "^wrk_[0-9A-Za-z]{6,32}$" },
    "source": { "$ref": "#/$defs/source" },
    "status": { "type": "string", "enum": ["draft", "ready", "stale"] },
    "style": { "$ref": "#/$defs/script_style" },
    "shots": { "type": "array", "items": { "$ref": "#/$defs/shot" } },
    "warnings": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["chapter_revision", "settings_revision", "content_hash"],
      "additionalProperties": false,
      "properties": {
        "chapter_revision": { "type": "integer", "minimum": 1 },
        "settings_revision": { "type": "integer", "minimum": 1 },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "script_style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visual_style": { "type": "string", "maxLength": 500 },
        "narration_voice_id": { "type": ["string", "null"], "pattern": "^voc_[0-9A-Za-z]{6,32}$" },
        "bgm_mood": { "type": "string", "maxLength": 200 }
      }
    },
    "anchor": {
      "type": "object",
      "required": ["block_id", "char_start", "char_end", "text_hash"],
      "additionalProperties": false,
      "properties": {
        "block_id": { "type": "string", "pattern": "^blk_[0-9A-Za-z]{6,32}$" },
        "char_start": { "type": "integer", "minimum": 0 },
        "char_end": { "type": "integer", "minimum": 0 },
        "text_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "line_id": { "type": ["string", "null"], "pattern": "^lin_[0-9A-Za-z]{6,32}$" },
        "state": { "type": "string", "enum": ["exact", "shifted", "orphan"] }
      }
    },
    "transition": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["cut", "fade", "dissolve", "none"] },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "shot": {
      "type": "object",
      "required": ["id", "index", "scene_label", "anchor", "lines", "revision"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^sht_[0-9A-Za-z]{6,32}$" },
        "index": { "type": "integer", "minimum": 1 },
        "scene_label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "location": { "type": ["string", "null"], "maxLength": 200 },
        "time_of_day": { "type": "string", "enum": ["dawn", "morning", "day", "dusk", "night", "unknown"] },
        "mood": { "type": ["string", "null"], "maxLength": 200 },
        "goal": { "type": ["string", "null"], "maxLength": 500 },
        "anchor": { "$ref": "#/$defs/anchor" },
        "transition_in": { "$ref": "#/$defs/transition" },
        "transition_out": { "$ref": "#/$defs/transition" },
        "status": { "type": "string", "enum": ["draft", "ready"] },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/line" } },
        "sfx_events": { "type": "array", "items": { "$ref": "#/$defs/sfx_event" } },
        "visuals": { "type": "array", "items": { "$ref": "#/$defs/visual" } },
        "animations": { "type": "array", "items": { "$ref": "#/$defs/animation" } },
        "silence_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/silence_event" },
          "description": "显式静音/停顿事件：Qwen3-TTS 无 SSML，停顿只能靠标点、切分与后期插入静音"
        },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "voice_override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider_id": {
          "type": ["string", "null"],
          "maxLength": 64,
          "description": "行级 TTS provider；为空走角色 → 工程默认 → provider_order 回落"
        },
        "voice_id": { "type": ["string", "null"], "pattern": "^voc_[0-9A-Za-z]{6,32}$" },
        "variant_id": {
          "type": ["string", "null"],
          "pattern": "^vav_[0-9A-Za-z]{6,32}$",
          "description": "直接指定音色变体；为空时按角色情绪映射解析"
        },
        "speed": { "type": ["number", "null"], "minimum": 0.5, "maximum": 2.0 },
        "emotion_map": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 60 }
        }
      }
    },
    "line": {
      "type": "object",
      "required": ["id", "index", "kind", "speaker_id", "text", "emotion", "anchor", "tts", "revision"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^lin_[0-9A-Za-z]{6,32}$" },
        "index": { "type": "integer", "minimum": 0, "description": "镜头内行序号，0 基" },
        "kind": { "type": "string", "enum": ["dialogue", "narration", "inner_monologue"] },
        "speaker_id": { "type": "string", "pattern": "^chr_[0-9A-Za-z]{6,32}$" },
        "voice": { "$ref": "#/$defs/voice_override" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "emotion": {
          "type": "string",
          "enum": ["neutral", "joy", "sad", "angry", "fear", "surprise", "tender", "excited", "whisper", "serious"]
        },
        "emotion_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "paralinguistic": {
          "type": "array",
          "items": { "type": "string", "enum": ["laugh", "sigh", "breath", "cry", "whisper"] },
          "uniqueItems": true,
          "description": "v2：副语言（哭腔/气声/耳语/笑/叹），自动路由硬条件"
        },
        "target_duration_ms": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "v2：期望时长；触发切分/静音填充/微变速补偿"
        },
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.0,
          "description": "Qwen3-TTS 无原生语速参数；该值由后期 atempo 变速实现，默认 1.0"
        },
        "pause_before_ms": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "pause_after_ms": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "delivery_note": { "type": ["string", "null"], "maxLength": 500 },
        "anchor": { "$ref": "#/$defs/anchor" },
        "tts": { "$ref": "#/$defs/tts_state" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "tts_state": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["pending", "running", "ready", "failed", "stale"] },
        "asset_id": { "type": ["string", "null"] },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "synthesized_revision": { "type": ["integer", "null"], "minimum": 1 },
        "provider_id": { "type": ["string", "null"], "maxLength": 64, "description": "实际使用的 provider，重算依据" },
        "model_version": { "type": ["string", "null"], "maxLength": 100, "description": "实际模型版本，provider 升级后需重算" },
        "voice_id": { "type": ["string", "null"], "pattern": "^voc_[0-9A-Za-z]{6,32}$" },
        "variant_id": { "type": ["string", "null"], "pattern": "^vav_[0-9A-Za-z]{6,32}$" },
        "routing": { "$ref": "#/$defs/routing", "description": "v2：自动路由决策，可解释可复现" },
        "chunks": {
          "type": "array",
          "description": "单次合成有长度上限：长行按标点切成 15~30 秒片段后逐段合成",
          "items": { "$ref": "#/$defs/tts_chunk" }
        },
        "error": {
          "type": ["object", "null"],
          "description": "统一错误：code/retryable/hint/message",
          "additionalProperties": true
        },
        "updated_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "routing": {
      "type": "object",
      "required": ["mode", "input_hash", "selected"],
      "additionalProperties": false,
      "description": "v2：自动路由决策记录；同 input_hash 复用，不重新打分",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["auto", "locked_line", "locked_character", "locked_project", "manual"]
        },
        "policy_revision": { "type": "integer", "minimum": 1 },
        "input_hash": { "type": "string", "maxLength": 128 },
        "selected": {
          "type": "object",
          "required": ["provider_id"],
          "additionalProperties": false,
          "properties": {
            "provider_id": { "type": "string", "maxLength": 64 },
            "variant_id": { "type": ["string", "null"], "pattern": "^vav_[0-9A-Za-z]{6,32}$" },
            "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
            "reasons": { "type": "array", "items": { "type": "string", "maxLength": 200 } }
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider_id", "stage", "reason"],
            "additionalProperties": false,
            "properties": {
              "provider_id": { "type": "string", "maxLength": 64 },
              "stage": { "type": "string", "enum": ["availability", "license", "capability", "variant", "resource", "score"] },
              "reason": { "type": "string", "maxLength": 64 },
              "detail": { "type": ["string", "null"], "maxLength": 300 }
            }
          }
        },
        "degradations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "enum": ["emotion_intensity_downgrade", "provider_fallback", "nonverbal_to_text", "duration_compensated"] },
              "from": { "type": ["string", "number", "null"] },
              "to": { "type": ["string", "number", "null"] },
              "detail": { "type": ["string", "null"], "maxLength": 300 },
              "reason": { "type": ["string", "null"], "maxLength": 64 }
            }
          }
        },
        "decided_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "tts_chunk": {
      "type": "object",
      "required": ["index", "text"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 0, "description": "切块序号，0 基" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "asset_id": { "type": ["string", "null"] },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "provider_id": { "type": ["string", "null"], "maxLength": 64, "description": "该块实际使用的 provider" },
        "variant_id": { "type": ["string", "null"], "pattern": "^vav_[0-9A-Za-z]{6,32}$" },
        "status": { "type": "string", "enum": ["pending", "ready", "failed"] }
      }
    },
    "position": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["before_line", "after_line", "during_line", "shot_start", "shot_end"] },
        "line_id": { "type": ["string", "null"], "pattern": "^lin_[0-9A-Za-z]{6,32}$" },
        "offset_ms": { "type": "integer", "minimum": -600000, "maximum": 600000 }
      }
    },
    "silence_event": {
      "type": "object",
      "required": ["id", "index", "duration_ms", "position", "anchor"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^sil_[0-9A-Za-z]{6,32}$" },
        "index": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "integer", "minimum": 50, "maximum": 30000 },
        "position": { "$ref": "#/$defs/position" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "reason": { "type": ["string", "null"], "maxLength": 200, "description": "如「对白之间呼吸停顿」「情绪转折留白」" }
      }
    },
    "sfx_event": {
      "type": "object",
      "required": ["id", "index", "kind", "prompt", "duration_ms", "position", "anchor", "asset", "revision"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^sfx_[0-9A-Za-z]{6,32}$" },
        "index": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string", "enum": ["ambience", "foley", "impact", "transition", "music_sting"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "duration_ms": { "type": "integer", "minimum": 100, "maximum": 600000 },
        "loop": { "type": "boolean" },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 12 },
        "fade_in_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "fade_out_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "position": { "$ref": "#/$defs/position" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "asset": { "$ref": "#/$defs/sfx_asset" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "sfx_asset": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["pending", "queued", "running", "ready", "failed", "skipped"] },
        "asset_id": { "type": ["string", "null"] },
        "actual_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "adapter": { "type": ["string", "null"], "maxLength": 60 },
        "cache_key": { "type": ["string", "null"] },
        "error": { "type": ["object", "null"], "additionalProperties": true }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["id", "index", "status", "seed", "params_hash"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^cnd_[0-9A-Za-z]{6,32}$" },
        "index": { "type": "integer", "minimum": 1 },
        "asset_id": { "type": ["string", "null"] },
        "job_id": { "type": ["string", "null"], "pattern": "^job_[0-9A-Za-z]{6,32}$" },
        "seed": { "type": "integer", "minimum": 0 },
        "params_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "status": { "type": "string", "enum": ["candidate", "selected", "rejected", "expired", "failed"] },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 5000 },
        "error": { "type": ["object", "null"], "additionalProperties": true }
      }
    },
    "draw": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batch_size": { "type": "integer", "minimum": 1, "maximum": 16 },
        "candidate_retention_days": { "type": "integer", "minimum": 1, "maximum": 365 },
        "selected_candidate_id": { "type": ["string", "null"], "pattern": "^cnd_[0-9A-Za-z]{6,32}$" }
      }
    },
    "visual": {
      "type": "object",
      "required": ["id", "index", "prompt", "aspect_ratio", "width", "height", "workflow_template_id", "anchor", "status", "candidates", "revision"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^img_[0-9A-Za-z]{6,32}$" },
        "index": { "type": "integer", "minimum": 1 },
        "shot_type": { "type": "string", "enum": ["特写", "中景", "全景", "空镜"] },
        "composition": { "type": ["string", "null"], "maxLength": 1000 },
        "character_ids": { "type": "array", "items": { "type": "string", "pattern": "^chr_[0-9A-Za-z]{6,32}$" } },
        "action": { "type": ["string", "null"], "maxLength": 1000 },
        "style": { "type": ["string", "null"], "maxLength": 500 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 6000 },
        "negative_prompt": { "type": ["string", "null"], "maxLength": 2000 },
        "aspect_ratio": { "type": "string", "enum": ["1:1", "3:4", "4:3", "9:16", "16:9"] },
        "width": { "type": "integer", "minimum": 256, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 256, "maximum": 4096 },
        "workflow_template_id": { "type": "string", "minLength": 1 },
        "params": { "type": "object", "additionalProperties": true },
        "anchor": { "$ref": "#/$defs/anchor" },
        "draw": { "$ref": "#/$defs/draw" },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
        "status": {
          "type": "string",
          "enum": ["pending", "queued", "generating", "candidates_ready", "selected", "failed", "stale"]
        },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "animation": {
      "type": "object",
      "required": ["id", "index", "mode", "duration_ms", "prompt", "audio_policy", "anchor", "status", "candidates", "revision"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^vid_[0-9A-Za-z]{6,32}$" },
        "index": { "type": "integer", "minimum": 1 },
        "visual_id": { "type": ["string", "null"], "pattern": "^img_[0-9A-Za-z]{6,32}$" },
        "mode": { "type": "string", "enum": ["i2v", "t2v"] },
        "duration_ms": { "type": "integer", "minimum": 500, "maximum": 5000 },
        "motion": { "type": ["string", "null"], "maxLength": 1000 },
        "camera_move": { "type": "string", "enum": ["static", "slow_push_in", "pan_left", "pan_right", "handheld"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "negative_prompt": { "type": ["string", "null"], "maxLength": 2000 },
        "workflow_template_id": { "type": "string", "minLength": 1 },
        "params": { "type": "object", "additionalProperties": true },
        "audio_policy": { "type": "string", "enum": ["keep", "mute", "duck"] },
        "fallback_visual_id": { "type": ["string", "null"], "pattern": "^img_[0-9A-Za-z]{6,32}$" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "draw": { "$ref": "#/$defs/draw" },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
        "status": {
          "type": "string",
          "enum": ["pending", "queued", "generating", "candidates_ready", "selected", "failed", "skipped", "stale"]
        },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "i2v" } }, "required": ["mode"] },
          "then": { "required": ["visual_id"] }
        }
      ]
    }
  }
}
