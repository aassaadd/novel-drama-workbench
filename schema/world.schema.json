{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-drama.local/schema/world.schema.json",
  "title": "世界条目库（worlds.json）",
  "description": "一本书可记录 1..n 条世界条目。世界观 / 规则 / 势力 / 地点 / 名词表的结构与设定库 world 字段保持一致。",
  "type": "object",
  "required": ["schema_version", "worlds"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "worlds": { "type": "array", "items": { "$ref": "#/$defs/world" } }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "world": {
      "type": "object",
      "required": [
        "id",
        "name",
        "era",
        "summary",
        "rules",
        "factions",
        "locations",
        "glossary",
        "visual_style",
        "cover_asset",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^wld_[0-9A-Za-z]{6,32}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120, "description": "世界名称，如「主世界」「镜中城」" },
        "era": { "type": "string", "minLength": 1, "maxLength": 200, "description": "时代背景" },
        "summary": { "type": "string", "maxLength": 2000, "description": "世界概述" },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        },
        "rules": {
          "type": "array",
          "items": { "type": "string", "maxLength": 500 },
          "description": "世界硬规则（超自然设定、物理限制等）"
        },
        "factions": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
        "glossary": {
          "type": "array",
          "items": { "$ref": "#/$defs/glossary_entry" },
          "description": "专有名词表，供上下文装配与一致性检查"
        },
        "visual_style": { "type": "string", "maxLength": 500, "description": "该世界统一画面风格，供图像提示词拼装" },
        "cover_asset": { "type": ["string", "null"], "description": "封面图相对路径；为空表示未生成" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "location": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^loc_[0-9A-Za-z]{6,32}$" },
        "name": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000 },
        "atmosphere": { "type": "string", "maxLength": 300, "description": "供音效与画面提示词使用" }
      }
    },
    "glossary_entry": {
      "type": "object",
      "required": ["term", "meaning"],
      "additionalProperties": true,
      "properties": {
        "term": { "type": "string", "maxLength": 120 },
        "meaning": { "type": "string", "maxLength": 1000 },
        "aliases": { "type": "array", "items": { "type": "string", "maxLength": 120 } }
      }
    }
  }
}
