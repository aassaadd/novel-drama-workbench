{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-drama.local/schema/key-image.schema.json",
  "title": "关键图 / 画面元素",
  "description": "归属于场景或镜头，锚定到具体台词行/正文块，通过 ComfyUI 模板出图。v1 用 anchor_line_id，v2 用 anchor（二者至少一个）。",
  "type": "object",
  "required": ["id", "index", "prompt", "aspect_ratio", "width", "height", "workflow_template_id", "revision"],
  "anyOf": [
    { "required": ["anchor_line_id"], "description": "v1：锚定台词行" },
    { "required": ["anchor"], "description": "v2：锚定正文块区间" }
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^img_[0-9A-Za-z]{6,32}$" },
    "scene_id": { "type": "string", "pattern": "^scn_[0-9A-Za-z]{6,32}$", "description": "v1 所属场景；v2 由所在镜头隐含，可省略" },
    "index": { "type": "integer", "minimum": 0 },
    "anchor_line_id": { "type": "string", "pattern": "^lin_[0-9A-Za-z]{6,32}$" },
    "anchor": { "$ref": "director-script.schema.json#/$defs/anchor", "description": "v2：回指正文段落块，用于改文后判定是否需要重画" },
    "anchor_desc": { "type": ["string", "null"], "maxLength": 500 },
    "shot_type": { "type": ["string", "null"], "enum": ["特写", "中景", "全景", "空镜", null], "description": "v2 景别" },
    "composition": { "type": ["string", "null"], "maxLength": 500, "description": "v2 构图描述" },
    "character_ids": { "type": "array", "items": { "type": "string", "pattern": "^chr_[0-9A-Za-z]{6,32}$" }, "description": "v2 出场角色" },
    "action": { "type": ["string", "null"], "maxLength": 500, "description": "v2 动作描述" },
    "style": { "type": ["string", "null"], "maxLength": 500, "description": "v2 画面风格" },
    "status": { "type": "string", "enum": ["pending", "queued", "generating", "candidates_ready", "selected", "failed", "stale"], "description": "v2 画面状态" },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "negative_prompt": { "type": ["string", "null"], "maxLength": 2000 },
    "prompt_source": { "type": "string", "enum": ["auto", "manual"] },
    "style_ref": { "type": ["string", "null"], "maxLength": 200 },
    "aspect_ratio": { "type": "string", "enum": ["1:1", "3:4", "4:3", "9:16", "16:9"] },
    "width": { "type": "integer", "minimum": 256, "maximum": 4096 },
    "height": { "type": "integer", "minimum": 256, "maximum": 4096 },
    "seed": { "type": ["integer", "null"], "minimum": 0 },
    "workflow_template_id": { "type": "string", "minLength": 1, "description": "仅引用模板 ID，工作流本身不内嵌" },
    "params": { "type": "object", "additionalProperties": true },
    "asset": { "$ref": "#/$defs/asset" },
    "draw": { "$ref": "director-script.schema.json#/$defs/draw", "description": "v2 抽卡：批量张数、候选保留期、已选中候选" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "director-script.schema.json#/$defs/candidate" },
      "description": "v2 抽卡候选；选中项进入时间轴"
    },
    "revision": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["pending", "queued", "running", "ready", "failed"] },
        "asset_id": { "type": ["string", "null"] },
        "job_id": { "type": ["string", "null"], "pattern": "^job_[0-9A-Za-z]{6,32}$" },
        "width": { "type": ["integer", "null"] },
        "height": { "type": ["integer", "null"] },
        "error": { "type": ["object", "null"], "additionalProperties": true }
      }
    }
  }
}
