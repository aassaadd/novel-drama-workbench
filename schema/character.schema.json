{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-drama.local/schema/character.schema.json",
  "title": "角色表（characters.json）",
  "description": "chr_narrator 为保留 ID，代表旁白，不可删除。v2 起音色库独立为 voices.json，角色通过 voice_library_id + 变体绑定引用。",
  "type": "object",
  "required": ["schema_version", "characters"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "characters": { "type": "array", "items": { "$ref": "#/$defs/character" } }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "character": {
      "type": "object",
      "required": ["id", "name", "role", "created_at", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^chr_[0-9A-Za-z]{6,32}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "aliases": { "type": "array", "items": { "type": "string", "maxLength": 60 }, "uniqueItems": true },
        "role": { "type": "string", "enum": ["protagonist", "antagonist", "supporting", "narrator", "minor"] },
        "gender": { "type": ["string", "null"], "enum": ["male", "female", "other", "unknown", null] },
        "age_range": { "type": ["string", "null"], "maxLength": 40 },
        "personality": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
        "background": { "type": "string", "maxLength": 2000 },
        "speech_style": { "$ref": "#/$defs/speech_style" },
        "voice_binding": { "$ref": "#/$defs/voice_binding", "description": "使用 TTS 时必填 voice_id" },
        "voice_profile": {
          "$ref": "#/$defs/voice_profile",
          "description": "R18：结构化音色描述。人物阶段一次生成，跨章复用，作为 voice design 抽卡输入"
        },
        "stock": {
          "$ref": "#/$defs/stock",
          "description": "R18：龙套槽位标记；只有 role=minor 的类型角色使用"
        },
        "appearance_prompt": { "type": "string", "maxLength": 2000 },
        "negative_prompt": { "type": "string", "maxLength": 1000 },
        "voice_description_zh": {
          "type": "string",
          "maxLength": 1000,
          "description": "R27：中文音色描述（音色/语速/语气/年龄感/口音），供界面展示与人工校对"
        },
        "voice_description_en": {
          "type": "string",
          "maxLength": 1000,
          "description": "R27：英文音色描述，可直接作为 TTS/voice design 的 prompt（纯英文）"
        },
        "appearance_desc_zh": {
          "type": "string",
          "maxLength": 1200,
          "description": "R27：中文外貌描述（正面），供界面展示与人工校对"
        },
        "appearance_desc_en": {
          "type": "string",
          "maxLength": 1200,
          "description": "R27：英文正面出图 prompt（纯英文，具体可见特征）"
        },
        "appearance_negative_zh": {
          "type": "string",
          "maxLength": 800,
          "description": "R27：中文负向说明（出图应排除的元素，名词短语）"
        },
        "appearance_negative_en": {
          "type": "string",
          "maxLength": 800,
          "description": "R27：英文 negative prompt（逗号分隔的排除项）"
        },
        "portrait_asset": { "type": ["string", "null"] },
        "image_assets": {
          "type": "object",
          "additionalProperties": false,
          "description": "角色图像素材：全身像母图、头像特写与三视图，均为相对路径；为空表示未生成",
          "properties": {
            "fullbody": { "type": ["string", "null"] },
            "closeup": { "type": ["string", "null"] },
            "turnaround": { "type": ["string", "null"] }
          }
        },
        "state": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "description": "v2：角色当前状态卡，供续写一致性与设定检索使用",
          "properties": {
            "situation": { "type": ["string", "null"], "maxLength": 1000 },
            "relationship_notes": {
              "type": ["object", "null"],
              "description": "v2：其他角色 ID → 关系备注",
              "additionalProperties": { "type": "string", "maxLength": 500 }
            },
            "knowledge": { "type": ["array", "null"], "items": { "type": "string", "maxLength": 200 } },
            "as_of_chapter_id": { "type": ["string", "null"], "pattern": "^chp_[0-9A-Za-z]{6,32}$" }
          }
        },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "narrator" } }, "required": ["role"] },
          "then": { "properties": { "id": { "const": "chr_narrator" } } }
        }
      ]
    },
    "speech_style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tempo": { "type": ["string", "null"], "maxLength": 40 },
        "pitch": { "type": ["string", "null"], "maxLength": 40 },
        "accent": { "type": ["string", "null"], "maxLength": 40 },
        "catchphrases": { "type": "array", "items": { "type": "string", "maxLength": 60 } }
      }
    },
    "voice_binding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["adapter"],
      "description": "v1 用 voice_id；v2 用 voice_library_id + default_variant_id，二者至少一个",
      "anyOf": [
        { "required": ["voice_id"] },
        { "required": ["voice_library_id"] }
      ],
      "properties": {
        "adapter": { "type": "string", "maxLength": 40 },
        "voice_id": { "type": ["string", "null"], "maxLength": 120, "description": "v1 兼容字段" },
        "voice_library_id": {
          "type": ["string", "null"],
          "pattern": "^voc_[0-9A-Za-z]{6,32}$",
          "description": "v2：指向 voices.json 的音色 ID，优先于 voice_id"
        },
        "default_variant_id": {
          "type": ["string", "null"],
          "pattern": "^vav_[0-9A-Za-z]{6,32}$",
          "description": "v2：默认音色变体；情绪未命中映射时使用"
        },
        "emotion_variant_map": {
          "type": "object",
          "description": "v2：情绪 → 音色变体 ID；Qwen3-TTS 克隆不支持指令控情绪，只能切换参考音频变体",
          "additionalProperties": { "type": "string", "pattern": "^vav_[0-9A-Za-z]{6,32}$" }
        },
        "fallback_voice_id": {
          "type": ["string", "null"],
          "pattern": "^voc_[0-9A-Za-z]{6,32}$",
          "description": "v2：首选音色不可用时的替代音色"
        },
        "provider_id": {
          "type": ["string", "null"],
          "maxLength": 64,
          "description": "v2：角色级 TTS provider 覆盖；为空时用工程 default_provider_id"
        },
        "fallback_provider_id": {
          "type": ["string", "null"],
          "maxLength": 64,
          "description": "v2：角色首选 provider 不可用时的替代 provider；为空时走工程 provider_order"
        },
        "reference_audio": { "type": ["string", "null"] },
        "seed": { "type": ["integer", "null"] },
        "speed": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
        "emotion_map": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 60 },
          "description": "统一情绪枚举 → 具体引擎情绪标签"
        }
      }
    },
    "voice_profile": {
      "type": "object",
      "description": "R18 音色描述：内容决策层，可评审、可作为文字造音色输入；允许扩展字段以兼容 R17 输出",
      "additionalProperties": true,
      "properties": {
        "schema": { "type": ["string", "null"], "maxLength": 40 },
        "summary": { "type": ["string", "null"], "maxLength": 300 },
        "voice_summary": { "type": ["string", "null"], "maxLength": 300, "description": "R17 兼容字段" },
        "gender": { "type": ["string", "null"], "enum": ["male", "female", "other", "unknown", null] },
        "gender_source": { "type": ["string", "null"], "enum": ["character", "manual", "inferred", null] },
        "age_feel": {
          "type": ["string", "null"],
          "enum": ["child", "teen", "young_adult", "adult", "middle_aged", "elderly", null]
        },
        "age_range_text": { "type": ["string", "null"], "maxLength": 40 },
        "age_range": { "type": ["string", "null"], "maxLength": 40, "description": "R17 兼容字段" },
        "pitch": { "type": ["string", "null"], "maxLength": 20 },
        "timbre": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
        "pace": { "type": ["string", "null"], "maxLength": 20 },
        "volume": { "type": ["string", "null"], "maxLength": 20 },
        "energy": { "type": ["string", "null"], "maxLength": 30 },
        "warmth": { "type": ["string", "null"], "maxLength": 30 },
        "articulation": { "type": ["string", "null"], "maxLength": 30 },
        "breathiness": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "raspiness": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "temperament": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
        "accent": { "type": ["string", "null"], "maxLength": 60 },
        "region_hint": { "type": ["string", "null"], "maxLength": 60 },
        "language": { "type": ["string", "null"], "maxLength": 20 },
        "role_distinctiveness": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "design_prompt": { "type": ["string", "null"], "maxLength": 1200 },
        "negative_prompt": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
        "reference_text": { "type": ["string", "null"], "maxLength": 500 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
        "source": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "description": "推导来源：kind/provider/model/at/from_hash/override_fields/batch_id"
        },
        "status": { "type": ["string", "null"], "enum": ["draft", "ready", "stale", "missing", null] },
        "stale_reason": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot"],
      "properties": {
        "slot": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,39}$",
          "description": "职业槽位稳定键（waiter/guard/...），落盘后不可改，改名走 cast rename-slot"
        },
        "voice_slot": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_]{1,39}$",
          "description": "音色池槽位（如 male_mid）；多个职业槽位可共用同一音色"
        },
        "label": { "type": ["string", "null"], "maxLength": 40 },
        "archetype_tags": { "type": "array", "items": { "type": "string", "maxLength": 20 } },
        "reuse_policy": { "type": "string", "enum": ["reuse", "per_scene"] }
      }
    }
  }
}
