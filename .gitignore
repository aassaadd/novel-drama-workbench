# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# 本机配置（含密钥，绝不入库）
config/config.yaml
# ComfyUI 模型线上地址解析缓存（用户级，不入库）
config/comfy/models.local.json

# 工程媒体与中间产物（工程目录通常不放在仓库内，这里兜底）
**/assets/voice/
**/assets/sfx/
**/assets/image/
**/assets/video/
**/renders/
**/exports/
**/.ndw/
**/timelines/

# 本地验证产生的音频与侧车（脚本与依赖快照仍入库）
var/**/*.wav
var/**/*.wav.json
var/ab_test/out/
var/tts/compare/

# 全平台操作日志（本机调试产物，不入库）
var/logs/

# macOS
.DS_Store
.trae
2026-11-12/bgm-codes-ab/outputs/A_codes_on_norm.wav
config/config.ui.yaml
.trae-html-share-packages
# 文档目录：顶层 Markdown（规格、方案、调研）全部入库；截图等派生资料仍不入库
docs/*
!docs/*.md
design/

# 本机标注验收 / 预览的临时产物（临时配置、临时工程与缓存、运行日志、预览文本，均不入库）
config/config.annotate_check.yaml
var/annotate_check_*
var/annotate_preview_*.log
var/preview_markup.txt
var/tmp
